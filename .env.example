# Existing local application database: SQLite at db.sqlite3 (no settings required).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Optional SMI MySQL source database.
# Populate the name, user, and host together to enable the "smi" database alias.
SMI_DB_ENGINE=django.db.backends.mysql
SMI_DB_NAME=
SMI_DB_USER=
SMI_DB_PASSWORD=
SMI_DB_HOST=
SMI_DB_PORT=3306
